{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LockYourIdea Tech Firebase Schema Blueprint",
  "description": "Firestore database blueprint for LockYourIdea Tech website and CRM",
  "entities": {
    "settings": {
      "path": "settings/main",
      "description": "Global website configuration, contact coordinates, images, and keys",
      "schema": {
        "type": "object",
        "properties": {
          "companyName": { "type": "string" },
          "tagline": { "type": "string" },
          "hqAddress": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string" },
          "heroBgImage": { "type": "string" },
          "portfolioBgImage": { "type": "string" },
          "industriesBgImage": { "type": "string" },
          "caseStudiesBgImage": { "type": "string" },
          "aboutBgImage": { "type": "string" },
          "contactBgImage": { "type": "string" },
          "aiHubBgImage": { "type": "string" },
          "ipHubBgImage": { "type": "string" },
          "web3formsKey": { "type": "string" },
          "logoUrl": { "type": "string" },
          "heroHeadline": { "type": "string" },
          "heroSubhead": { "type": "string" },
          "stats": {
            "type": "object",
            "properties": {
              "aiProjects": { "type": "string" },
              "ipRegistrations": { "type": "string" },
              "enterpriseClients": { "type": "string" },
              "trainedCount": { "type": "string" },
              "successRate": { "type": "string" }
            }
          }
        }
      }
    },
    "pageContent": {
      "path": "pageContent/{pageId}",
      "description": "Dynamic editable headings, descriptions, badges, and background images for every page (home, ai-hub, ip-hub, portfolio, case-studies, about, contact)",
      "schema": {
        "type": "object",
        "properties": {
          "pageId": { "type": "string" },
          "title": { "type": "string" },
          "headline": { "type": "string" },
          "subheadline": { "type": "string" },
          "badge": { "type": "string" },
          "bgImage": { "type": "string" },
          "extraSections": { "type": "object" },
          "updatedAt": { "type": "string" }
        },
        "required": ["pageId", "headline"]
      }
    },
    "bookings": {
      "path": "bookings/{bookingId}",
      "description": "Client scheduled real-time consultations",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "reference": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "mobile": { "type": "string" },
          "organization": { "type": "string" },
          "designation": { "type": "string" },
          "orgType": { "type": "string" },
          "service": { "type": "string" },
          "division": { "type": "string" },
          "budget": { "type": "string" },
          "date": { "type": "string" },
          "timeSlot": { "type": "string" },
          "mode": { "type": "string" },
          "meetingLink": { "type": "string" },
          "assignedConsultant": { "type": "object" },
          "message": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed", "in-progress", "completed", "cancelled"] },
          "createdAt": { "type": "string" }
        },
        "required": ["id", "fullName", "email", "mobile", "date", "timeSlot", "status"]
      }
    },
    "portfolio": {
      "path": "portfolio/{itemId}",
      "description": "Case studies and portfolio engagements",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tag": { "type": "string" },
          "imageUrl": { "type": "string" },
          "client": { "type": "string" },
          "result": { "type": "string" }
        },
        "required": ["id", "title", "description", "category"]
      }
    },
    "customServices": {
      "path": "customServices/{serviceId}",
      "description": "Admin configured service offerings",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "division": { "type": "string" }
        },
        "required": ["id", "title"]
      }
    },
    "emails": {
      "path": "emails/{emailId}",
      "description": "Dispatched email notification audit logs",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "recipient": { "type": "string" },
          "recipientName": { "type": "string" },
          "subject": { "type": "string" },
          "htmlContent": { "type": "string" },
          "status": { "type": "string" },
          "sentAt": { "type": "string" },
          "type": { "type": "string" },
          "bookingId": { "type": "string" }
        },
        "required": ["id", "recipient", "subject", "status"]
      }
    }
  }
}
