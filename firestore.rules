rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /pageContent/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /customServices/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string &&
                       request.resource.data.email is string;
      allow update, delete: if true;
    }

    match /emails/{emailId} {
      allow read, write: if true;
    }
  }
}
